#!/bin/sh

# AmneziaWG autostart on boot
# Installed to /usr/local/etc/rc.syshook.d/start/50-amneziawg

LOG="/tmp/amneziawg_syshook.log"

exec >> "$LOG" 2>&1
echo ""
echo "=== amneziawg syshook start: $(date) ==="

AWG_BIN="/usr/local/bin/awg"
AWG_QUICK="/usr/local/bin/awg-quick"
SERVICE_CONTROL="/usr/local/opnsense/scripts/AmneziaWG/amneziawg-service-control.php"

# Check if enabled in config.xml
ENABLED=$(php -r 'require_once("config.inc"); $cfg = OPNsense\Core\Config::getInstance()->object(); echo (string)($cfg->OPNsense->amneziawg->general->enabled ?? "0");' 2>/dev/null)

echo "enabled=[$ENABLED]"

[ "$ENABLED" = "1" ] || { echo "amneziawg disabled, exit"; exit 0; }
[ -x "$AWG_BIN" ]    || { echo "awg binary not found"; exit 0; }
[ -x "$AWG_QUICK" ]  || { echo "awg-quick binary not found"; exit 0; }
[ -f "$SERVICE_CONTROL" ] || { echo "service-control not found"; exit 0; }

# Verify kernel module before starting tunnel (prevents boot hang on kmod mismatch)
if ! kldstat -q -m if_amn 2>/dev/null; then
    echo "if_amn module not loaded, attempting kldload..."
    if ! kldload if_amn 2>&1; then
        echo "FATAL: cannot load if_amn — skipping tunnel start (kernel/module version mismatch?)"
        exit 0
    fi
fi

echo "starting amneziawg via service-control..."
php "$SERVICE_CONTROL" start 2>&1

# The hook can run before DHCP has assigned the WAN address.  awg-quick then
# creates awgN but cannot finish address/peer setup.  Retry once the configured
# WAN has an address instead of leaving a partial interface until the watchdog.
WAN_IF=$(php -r 'require_once("config.inc"); $cfg = OPNsense\Core\Config::getInstance()->object(); echo (string)($cfg->interfaces->wan->if ?? "");' 2>/dev/null)
(
    attempt=0
    while [ "$attempt" -lt 30 ]; do
        if [ -n "$WAN_IF" ] && ifconfig "$WAN_IF" 2>/dev/null | grep -q '[[:space:]]inet '; then
            echo "WAN address available on $WAN_IF; reconfiguring AmneziaWG"
            php "$SERVICE_CONTROL" reconfigure 2>&1
            exit 0
        fi
        attempt=$((attempt + 1))
        sleep 2
    done
    echo "WAN address did not appear; watchdog will retry"
) >> "$LOG" 2>&1 &

echo "=== done: $(date) ==="
exit 0
